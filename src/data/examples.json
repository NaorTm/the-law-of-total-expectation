      {"title": "Step 3", "explanationMarkdown": "Poisson mean is lambda.", "mathLatex": "\\mathbb{E}[S]=4\\cdot3=12"},
      {"title": "Step 4", "explanationMarkdown": "Simulation check.", "mathLatex": "\\hat{\\mu}_N\\approx12"}
    ],
    "alternateMethod": "Wald's identity.",
    "simulation": {
      "type": "random_sum_poisson",
      "parameters": {"mu": 4, "lambda": 3, "sigma": 1},
      "samplerJs": "const n=poissonSample(3,rng); let s=0; for(let i=0;i<n;i++) s+=normalSample(4,1,rng); return s;"
    },
    "expectedValueLatex": "\\mathbb{E}[S]=12",
    "finalResult": 12,
    "keyTakeaway": "E[random sum]=E[count]*E[increment] under independence."
  },
